# Application settings
APP_NAME=ЖКХ Контроль
APP_VERSION=local

# MAX bot settings. Never commit real secrets.
MAX_BOT_TOKEN=replace_me
# MAX user ID of the first administrator.
INITIAL_ADMIN_MAX_USER_ID=
PUBLIC_BASE_URL=https://max.conspiracy-team.ru
MAX_WEBHOOK_SECRET=replace_me_with_5_or_more_chars
# Invite code lifetime. Go duration format: 24h, 72h, 30m.
INVITE_CODE_TTL=24h

# Tarantool
TARANTOOL_ADDRESS=tarantool:3301
TARANTOOL_USER=app
TARANTOOL_PASSWORD=replace_me

# SeaweedFS S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=seaweedfs:8333
OBJECT_STORAGE_ACCESS_KEY=admin
OBJECT_STORAGE_SECRET_KEY=replace_me_with_long_password
OBJECT_STORAGE_BUCKET=work-evidence

# Internal event broker
MESSAGE_BROKER_URL=nats://nats:4222
NATS_IMAGE=nats:2.11-alpine

